{% extends 'layouts/page.njk' %}

{% block content %}
  {{ super() }}

  {{ appHeading({
    text: heading
  }) }}

  <ul class="govuk-list app-section-list">
    {% for section in sections %}
      <li class="app-section-list__item">
        <h2 class="govuk-heading-m govuk-!-margin-bottom-1">
          <a class="govuk-link" href="{{ section.href }}">{{ section.text }}</a>
        </h2>
        <p class="govuk-body govuk-!-margin-bottom-0">{{ section.description }}</p>
      </li>
    {% endfor %}
  </ul>
{% endblock %}
