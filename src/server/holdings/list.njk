{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% block content %}
  {{ super() }}

  {{ appHeading({
    text: heading
  }) }}

  {% if apiError %}
    {{ govukNotificationBanner({
      html: '<p class="govuk-body">Unable to read holdings from the backend API' + (' (HTTP ' + apiError.statusCode + ')' if apiError.statusCode else '') + '.</p>'
    }) }}
  {% endif %}

  <form method="get" action="/holdings" class="govuk-!-margin-bottom-6">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-half">
        {{ govukInput({
          label: { text: "Search" },
          hint: { text: "CPH, holding name, address or associated party" },
          id: "search",
          name: "search",
          value: filters.search,
          classes: "govuk-input--width-20"
        }) }}
      </div>
      <div class="govuk-grid-column-one-quarter">
        {% set orderItems = [] %}
        {% for option in orderOptions %}
          {% set orderItems = (orderItems.push({
            value: option.value,
            text: option.text,
            selected: filters.order === option.value
          }), orderItems) %}
        {% endfor %}
        {{ govukSelect({
          label: { text: "Order by" },
          id: "order",
          name: "order",
          items: orderItems
        }) }}
      </div>
      <div class="govuk-grid-column-one-quarter">
        {{ govukSelect({
          label: { text: "Direction" },
          id: "sort",
          name: "sort",
          items: [
            { value: "asc", text: "Ascending", selected: filters.sort !== "desc" },
            { value: "desc", text: "Descending", selected: filters.sort === "desc" }
          ]
        }) }}
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-quarter">
        {% set pageSizeItems = [] %}
        {% for size in pageSizeOptions %}
          {% set pageSizeItems = (pageSizeItems.push({
            value: size,
            text: size + " per page",
            selected: filters.pageSize === size
          }), pageSizeItems) %}
        {% endfor %}
        {{ govukSelect({
          label: { text: "Page size" },
          id: "pageSize",
          name: "pageSize",
          items: pageSizeItems
        }) }}
      </div>
    </div>

    {{ govukButton({
      text: "Search"
    }) }}
  </form>

  {% if dataTimestamp %}
    <p class="govuk-body-s govuk-hint">Snapshot taken {{ dataTimestamp | formatDate("d MMM yyyy HH:mm:ss") }}</p>
  {% endif %}

  {% if holdings.length > 0 %}
    <p class="govuk-body">Showing page {{ pagination.page }} of {{ pagination.totalPages }} ({{ pagination.totalCount }} total)</p>

    <table class="govuk-table">
      <thead class="govuk-table__header">
        <tr class="govuk-table__row">
          <th class="govuk-table__header" scope="col">CPH</th>
          <th class="govuk-table__header" scope="col">Name</th>
          <th class="govuk-table__header" scope="col">Type</th>
          <th class="govuk-table__header" scope="col">Start date</th>
          <th class="govuk-table__header" scope="col">End date</th>
          <th class="govuk-table__header" scope="col">Parties</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for holding in holdings %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="/holdings/{{ holding.identifier }}">{{ holding.identifier }}</a>
            </td>
            <td class="govuk-table__cell">{{ holding.name }}</td>
            <td class="govuk-table__cell">{{ holding.holdingType }}</td>
            <td class="govuk-table__cell">{{ holding.startDate | formatDate if holding.startDate else "—" }}</td>
            <td class="govuk-table__cell">{{ holding.endDate | formatDate if holding.endDate else "—" }}</td>
            <td class="govuk-table__cell">{{ holding.partyCount }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    {% include "partials/pagination.njk" %}
  {% elif not apiError %}
    <p class="govuk-body">No holdings found</p>
  {% endif %}
{% endblock %}
